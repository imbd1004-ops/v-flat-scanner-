{
  "name": "v-flat-scanner",
  "private": true,
  "version": "0.1.0",
  "description": "Point your phone at a book: the page is detected, flattened and OCR'd on-device. Installable PWA.",
  "type": "module",
  "scripts": {
    "sync-vendor": "node scripts/sync-vendor.mjs",
    "predev": "npm run sync-vendor",
    "dev": "vite --host",
    "prebuild": "npm run sync-vendor",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.0"
  }
}
